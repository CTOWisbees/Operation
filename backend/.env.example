# ==============================================================================
# WISBEES OPERATIONS PORTAL - BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================

# --- Django Core Settings ---
DJANGO_SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*
# In production on Render: ALLOWED_HOSTS=.onrender.com,localhost

# --- Email / SMTP Settings (For Password Reset OTP & Notifications) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL=WisBees Operations <your_email@gmail.com>

# --- Ghost CMS Integration ---
GHOST_URL=https://www.wisbees.com
GHOST_CONTENT_API_KEY=your_ghost_content_api_key
GHOST_NEWSLETTER_TAG=newsletter

# --- Groq AI Key ---
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Azure & Microsoft Graph (Optional / Newsletter) ---
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_SENDER_EMAIL=info@wisbees.com
AZURE_NOTIFICATION_EMAIL=info@wisbees.com

NEWSLETTER_CLIENT_ID=your_newsletter_client_id
NEWSLETTER_CLIENT_SECRET=your_newsletter_client_secret
NEWSLETTER_TENANT_ID=your_newsletter_tenant_id
NEWSLETTER_SENDER_EMAIL=info@wisbees.com
